// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  school       String?
  avatarUrl    String?
  reputation   Int      @default(0)
  badges       Badge[]
  comments     Comment[]
  reviews      Review[]
  // 사용자가 소유한 책들
  books        Book[]
  // 여정 노드 (사용자의 흔적)
  journeyNodes JourneyNode[]
  // 교환(요청자) 측 관계
  requestedExchanges Exchange[] @relation("UserExchanges")
  // 교환(소유자) 측 관계
  ownedExchanges     Exchange[] @relation("OwnerExchanges")
  createdAt    DateTime @default(now())
}

model Book {
  id           String   @id @default(cuid())
  title        String
  author       String
  coverUrl     String?
  condition    String    // 상태
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  genre        String?
  isExchangeable Boolean @default(true)
  journeyNodes JourneyNode[]
  reviews      Review[]
  exchanges    Exchange[]
  createdAt    DateTime  @default(now())
}

model JourneyNode {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  city      String?
  lat       Float?
  lng       Float?
  note      String?   // 독자 코멘트(여정 흔적)
  emotion   String?   // 감정 태그
  createdAt DateTime  @default(now())
}

model Exchange {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  requesterId String
  requester User     @relation("UserExchanges", fields: [requesterId], references: [id])
  ownerId     String
  owner       User    @relation("OwnerExchanges", fields: [ownerId], references: [id])
  method    String   // '택배' | '보관함'
  status    String   // 'requested'|'accepted'|'shipped'|'received'|'completed'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  rating    Int      @default(0)
  comments  Comment[]
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  reviewId  String?
  review    Review?  @relation(fields: [reviewId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // '리뷰왕'|'여정리더' 등
  createdAt DateTime @default(now())
}
